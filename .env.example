# Copy to .env and set real values. .env is git-ignored.
# Used by docker-compose.yml for every demo branch database.
BRANCH_DB_PASSWORD=change-me
# SCRAM password per demo branch: the same values HQ uses when onboarding the branch (infra/onboard-branch.sh)
BR0001_KAFKA_PASSWORD=change-me
BR0002_KAFKA_PASSWORD=change-me
# CA certificate from HQ (created by branch-sales-consumer/infra/tls/generate-certs.sh)
HQ_CA_CERT=../branch-sales-consumer/infra/tls/out/ca.crt
