# Copy to .env and set real values. .env is git-ignored. Used by every demo branch.
BRANCH_DB_PASSWORD=change-me
# Producer's read-only login to the branch database
BRANCH_READER_PASSWORD=change-me
MONGO_ROOT_PASSWORD=change-me
# Producer's MongoDB login
MONGO_PASSWORD=change-me
# Per demo branch: HQ's password at the branch broker and the broker certificate, both from HQ's onboard-branch.sh
BR0001_HQ_KAFKA_PASSWORD=change-me
BR0001_KAFKA_PEM=../branch-sales-consumer/infra/tls/out/branches/BR0001/kafka.pem
BR0002_HQ_KAFKA_PASSWORD=change-me
BR0002_KAFKA_PEM=../branch-sales-consumer/infra/tls/out/branches/BR0002/kafka.pem
